# Copy to .env.local for local development (never commit real values).
# For cloud builds, set the same names with `eas env:create` (see SETUP.md).

# Strava API application: Client ID (public) from https://www.strava.com/settings/api
EXPO_PUBLIC_STRAVA_CLIENT_ID=
# URL of the deployed token function, e.g. https://<project-ref>.supabase.co/functions/v1/strava-token
EXPO_PUBLIC_STRAVA_TOKEN_URL=
# Meta (Facebook) App ID, for sharing straight to Instagram Stories
EXPO_PUBLIC_META_APP_ID=
